#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
packaging_root=$(CDPATH='' cd -- "$script_dir/../../.." && pwd -P)
kernel_image=${PRONK_VM_KERNEL_IMAGE:?set PRONK_VM_KERNEL_IMAGE to a CastKMS bzImage}
kernel_build=${PRONK_VM_KERNEL_BUILD:-${kernel_image%/arch/x86/boot/bzImage}}
mutter_build=${PRONK_VM_MUTTER_BUILD:?set PRONK_VM_MUTTER_BUILD to the Mutter build directory}
stage=${PRONK_VM_STAGE:-${PRONK_SYSEXT_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pronk-sysext}/staged}
results=${PRONK_VM_RESULTS:-${XDG_STATE_HOME:-$HOME/.local/state}/pronk-vm-results}
crtc_id=${PRONK_VM_CRTC_ID:?set PRONK_VM_CRTC_ID to a CastKMS CRTC ID}
connector_id=${PRONK_VM_CONNECTOR_ID:?set PRONK_VM_CONNECTOR_ID to a CastKMS connector ID}
width=${PRONK_VM_WIDTH:-1920}
height=${PRONK_VM_HEIGHT:-1080}
receiver=${PRONK_VM_RECEIVER:-}
allow_kernel_release_mismatch=${PRONK_VM_ALLOW_KERNEL_RELEASE_MISMATCH:-0}
copy_mode=${PRONK_VM_COPY_MODE:-primary-gpu-cpu}
use_mutter_build=${PRONK_VM_USE_MUTTER_BUILD:-0}
use_fbos=${PRONK_VM_USE_FBOS:-auto}
test_case=${PRONK_VM_TEST:-media}
interactive=${PRONK_VM_INTERACTIVE:-0}
shell_layout_js=${PRONK_VM_SHELL_LAYOUT_JS:-}
browser_url=${PRONK_VM_BROWSER_URL:-}
guest_memory=${PRONK_VM_MEMORY:-2G}
video_rate=${PRONK_VM_VIDEO_RATE:-30}
[[ $video_rate == 30 || $video_rate == 60 ]] || {
	printf 'PRONK_VM_VIDEO_RATE must be 30 or 60\n' >&2
	exit 2
}
if [[ $test_case == media-gpu || $test_case == service-gpu ]]; then
	copy_mode=${PRONK_VM_COPY_MODE:-zero-copy}
	guest_memory=${PRONK_VM_MEMORY:-4G}
fi
[[ $interactive == 0 || $interactive == 1 ]] || {
	printf 'PRONK_VM_INTERACTIVE must be 0 or 1\n' >&2
	exit 2
}
if [[ $interactive == 1 && ($test_case != media-gpu && $test_case != service-gpu || -z $receiver) ]]; then
	printf 'interactive VM casting requires a GPU media test and a receiver\n' >&2
	exit 2
fi
if [[ -n $shell_layout_js && ($interactive != 1 || ! -f $shell_layout_js || ${shell_layout_js##*/} != layout.js) ]]; then
	printf 'PRONK_VM_SHELL_LAYOUT_JS requires an interactive VM and an existing layout.js\n' >&2
	exit 2
fi
if [[ -n $browser_url && ($interactive != 1 || $browser_url != https://*) ]]; then
	printf 'PRONK_VM_BROWSER_URL requires an interactive VM and an HTTPS URL\n' >&2
	exit 2
fi
if [[ -n $browser_url && ! -x /usr/bin/firefox ]]; then
	printf 'PRONK_VM_BROWSER_URL requires /usr/bin/firefox in the guest root\n' >&2
	exit 2
fi
if [[ $test_case == service-gpu && -z $receiver ]]; then
	printf 'service-gpu requires a receiver\n' >&2
	exit 2
fi
pattern=${PRONK_VM_PATTERN:-gtk}
renderer_build=${PRONK_VM_RENDERER_BUILD:-}
use_renderer=${PRONK_VM_USE_RENDERER:-1}
if [[ $test_case == media-gpu ]]; then
	use_renderer=${PRONK_VM_USE_RENDERER:-1}
fi
pronk_bin_dir=${PRONK_VM_PRONK_BIN_DIR:-}
mesa_stage=${PRONK_VM_MESA_STAGE:-}
video_build=${PRONK_VM_VIDEO_BUILD:-}
drm_debug=${PRONK_VM_DRM_DEBUG:-0}
gpu_device=${PRONK_VM_GPU_DEVICE:-virtio-gpu-gl-pci,blob=true,venus=true,hostmem=512M}
pronk_source=$packaging_root/sources/pronk
mutter_source=$packaging_root/sources/mutter
gpu_media=0
case $test_case in
media|media-gpu) test_name=pronk-capture-mutter-media-live-test ;;
gpu-capture) test_name=pronk-capture-mutter-gpu-live-test ;;
service-gpu) test_name=pronkd ;;
*) printf 'unsupported VM test: %s\n' "$test_case" >&2; exit 2 ;;
esac
if [[ $test_case == media-gpu || $test_case == service-gpu ]]; then
	gpu_media=1
	[[ -n $video_build && -n $mesa_stage && $copy_mode != primary-gpu-cpu &&
	   $use_renderer == 1 ]] || {
		printf 'media-gpu requires a video VM build, Mesa stage, GPU Mutter copy, and the renderer daemon\n' >&2
		exit 2
	}
fi
test_binary=${pronk_bin_dir:-$pronk_source/target/debug}/$test_name
if [[ $test_case == service-gpu ]]; then
	test_binary=$stage/usr/bin/pronkd
fi
log=$results/assembly.log

for value in "$crtc_id" "$connector_id" "$width" "$height"; do
	[[ $value =~ ^[1-9][0-9]*$ ]] || {
		printf 'CRTC, connector, width and height must be positive integers\n' >&2
		exit 2
	}
done
case $copy_mode in
primary-gpu-cpu|primary-gpu-gpu|zero-copy) ;;
*) printf 'unsupported copy mode: %s\n' "$copy_mode" >&2; exit 2 ;;
esac
if [[ $test_case == gpu-capture && $copy_mode == primary-gpu-cpu ]]; then
	printf 'gpu-capture requires a GPU-only Mutter copy mode\n' >&2
	exit 2
fi
[[ $pattern == gtk || $pattern == shm ]] || {
	printf 'PRONK_VM_PATTERN must be gtk or shm\n' >&2
	exit 2
}
[[ $allow_kernel_release_mismatch == 0 || $allow_kernel_release_mismatch == 1 ]] || {
	printf 'PRONK_VM_ALLOW_KERNEL_RELEASE_MISMATCH must be 0 or 1\n' >&2
	exit 2
}
[[ $use_mutter_build == 0 || $use_mutter_build == 1 ]] || {
	printf 'PRONK_VM_USE_MUTTER_BUILD must be 0 or 1\n' >&2
	exit 2
}
[[ $use_fbos == auto || $use_fbos == 0 || $use_fbos == 1 ]] || {
	printf 'PRONK_VM_USE_FBOS must be auto, 0 or 1\n' >&2
	exit 2
}
[[ $use_renderer == 0 || $use_renderer == 1 ]] || {
	printf 'PRONK_VM_USE_RENDERER must be 0 or 1\n' >&2
	exit 2
}
[[ $guest_memory =~ ^[1-9][0-9]*G$ ]] || {
	printf 'PRONK_VM_MEMORY must be a positive whole number of GiB\n' >&2
	exit 2
}
if [[ $use_mutter_build == 1 && ! -f $mutter_build/src/libmutter-51.so.0.0.0 ]]; then
	printf 'Mutter build library is missing\n' >&2
	exit 2
fi
if [[ -n $renderer_build && ! -x $renderer_build/castkms-rendererd ]]; then
	printf 'renderer build executable is missing\n' >&2
	exit 2
fi
if [[ -n $pronk_bin_dir && $test_case != service-gpu && ! -x $pronk_bin_dir/pronk-capture-pattern-client ]]; then
	printf 'Pronk pattern client is missing from the alternate binary directory\n' >&2
	exit 2
fi
if [[ -n $mesa_stage ]]; then
	mesa_libdir=$("$script_dir/check-mesa-stage" --libdir "$mesa_stage")
fi
if [[ -n $video_build ]]; then
	[[ -n $mesa_stage && -x $video_build/qemu/qemu-system-x86_64 &&
	   -f $video_build/virglrenderer/src/libvirglrenderer.so.1 &&
	   -x $video_build/virglrenderer/server/virgl_render_server ]] || {
		printf 'video VM build and video-enabled Mesa stage are required together\n' >&2
		exit 2
	}
	grep -Fqx "QEMU_REVISION=$(git -C "$packaging_root/sources/qemu" rev-parse HEAD)" \
		"$video_build/manifest"
	grep -Fqx "VIRGLRENDERER_REVISION=$(git -C "$packaging_root/sources/virglrenderer" rev-parse HEAD)" \
		"$video_build/manifest"
	"$video_build/qemu/qemu-system-x86_64" -netdev help |
		grep -Eq '^user([[:space:]]|$)' || {
		printf 'video VM QEMU lacks user-mode networking\n' >&2
		exit 2
	}
fi
[[ $drm_debug =~ ^(0x[0-9a-fA-F]+|[0-9]+)$ ]] || {
	printf 'PRONK_VM_DRM_DEBUG must be a numeric DRM debug mask\n' >&2
	exit 2
}
[[ -z $receiver || $receiver =~ ^[A-Za-z0-9.:-]+$ ]] || {
	printf 'receiver must be a host:port without shell metacharacters\n' >&2
	exit 2
}
[[ -f $kernel_image && -d $kernel_build && -d $mutter_build && -x $test_binary ]] || {
	printf 'kernel image/build, Mutter build, or Pronk live-test binary is missing\n' >&2
	exit 2
}
[[ -f $stage/usr/lib/pronk-sysext/manifest ]] || {
	printf 'staged system extension is missing: %s\n' "$stage" >&2
	exit 2
}
for source in castkms pronk mutter; do
	case $source in
	castkms) manifest_key=CASTKMS_REVISION ;;
	pronk) manifest_key=PRONK_REVISION ;;
	mutter) manifest_key=MUTTER_REVISION ;;
	esac
	[[ $source == mutter ]] && source_path=$mutter_source || \
		source_path=$packaging_root/sources/$source
	revision=$(git -C "$source_path" rev-parse --short=12 HEAD)
	grep -Fqx "$manifest_key=$revision" \
		"$stage/usr/lib/pronk-sysext/manifest" || {
		printf 'staged %s revision does not match %s\n' \
			"$source" "$source_path" >&2
		exit 2
	}
done
[[ -f $mutter_source/src/tests/meta-dbus-runner.py ]] || {
	printf 'Mutter session test runner is missing\n' >&2
	exit 2
}
if [[ -z $video_build ]]; then
	command -v qemu-system-x86_64 >/dev/null
fi
command -v virtme-run >/dev/null
if pgrep -f '^/usr/bin/qemu-system-|^qemu-system-' >/dev/null; then
	printf 'another QEMU VM is active\n' >&2
	exit 1
fi
if [[ -n $video_build ]] &&
   pgrep -f "^$video_build/qemu/qemu-system-x86_64 " >/dev/null; then
	printf 'another video VM is active\n' >&2
	exit 1
fi
mkdir -p "$results"
pattern_bin=/run/pronk-source/target/debug/pronk-capture-pattern-client
if [[ -n $pronk_bin_dir ]]; then
	pattern_bin=/run/pronk-bin/pronk-capture-pattern-client
fi
if [[ $pattern == shm ]]; then
	protocol=/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml
	command -v wayland-scanner >/dev/null
	[[ -f $protocol ]] || { printf 'xdg-shell protocol is missing\n' >&2; exit 2; }
	wayland-scanner client-header "$protocol" "$results/xdg-shell-client-protocol.h"
	wayland-scanner private-code "$protocol" "$results/xdg-shell-protocol.c"
	cc -std=c11 -Wall -Wextra -Werror -O2 \
		-I"$results" "$script_dir/wl-shm-pattern.c" \
		"$results/xdg-shell-protocol.c" -o "$results/wl-shm-pattern" \
		$(pkg-config --cflags --libs wayland-client)
	pattern_bin=/run/results/wl-shm-pattern
fi

# This is a host virglrenderer setting, not a guest or CastKMS setting.
# Explicit 0 remains available for a negative-control run.
export VIRGL_GBM_LAYOUT_ENABLE=${VIRGL_GBM_LAYOUT_ENABLE:-1}
qemu_args=()
if [[ -n $video_build ]]; then
	export LD_LIBRARY_PATH="$video_build/virglrenderer/src${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
	export RENDER_SERVER_EXEC_PATH="$video_build/virglrenderer/server/virgl_render_server"
	qemu_args+=(--qemu-bin "$video_build/qemu/qemu-system-x86_64")
fi
[[ $VIRGL_GBM_LAYOUT_ENABLE == 0 || $VIRGL_GBM_LAYOUT_ENABLE == 1 ]] || {
	printf 'VIRGL_GBM_LAYOUT_ENABLE must be 0 or 1\n' >&2
	exit 2
}
guest_command=$(printf 'PRONK_VM_COPY_MODE=%q PRONK_VM_RECEIVER=%q PRONK_VM_ALLOW_KERNEL_RELEASE_MISMATCH=%q PRONK_VM_USE_MUTTER_BUILD=%q PRONK_VM_USE_FBOS=%q PRONK_VM_TEST=%q PRONK_VM_GPU_MEDIA=%q PRONK_VM_USE_PRONK_BIN=%q PRONK_VM_USE_MESA_STAGE=%q PRONK_VM_MESA_LIBDIR=%q PRONK_VM_USE_RENDERER=%q PRONK_VM_USE_VIDEO=%q PRONK_VM_VIDEO_RATE=%q PRONK_VM_INTERACTIVE=%q PRONK_VM_SHELL_LAYOUT_OVERLAY=%q PRONK_VM_BROWSER_URL=%q PRONK_VM_CLUTTER_PAINT=%q PRONK_PATTERN_BIN=%q sh /run/test/guest %q %q %q %q' \
    "$copy_mode" "$receiver" "$allow_kernel_release_mismatch" "$use_mutter_build" "$use_fbos" "$test_case" "$gpu_media" "${pronk_bin_dir:+1}" "${mesa_stage:+1}" "${mesa_libdir:-}" "$use_renderer" "${video_build:+1}" "$video_rate" "$interactive" "${shell_layout_js:+/run/shell-layout/layout.js}" "$browser_url" "${PRONK_VM_CLUTTER_PAINT:-}" "$pattern_bin" \
	"$crtc_id" "$connector_id" "$width" "$height")

printf 'Host virgl GBM layout: %s\n' "$VIRGL_GBM_LAYOUT_ENABLE"
if [[ $use_mutter_build == 1 ]]; then
	printf 'Guest Mutter library: %s\n' "$mutter_build/src/libmutter-51.so.0.0.0"
fi
printf 'VM log: %s\n' "$log"
: >"$log"
renderer_mount=()
if [[ -n $renderer_build ]]; then
	renderer_mount+=("--rodir=/run/renderer-build=$renderer_build")
fi
pronk_bin_mount=()
if [[ -n $pronk_bin_dir ]]; then
	pronk_bin_mount+=("--rodir=/run/pronk-bin=$pronk_bin_dir")
fi
mesa_mount=()
if [[ -n $mesa_stage ]]; then
	mesa_mount+=("--rodir=/run/mesa-stage=$mesa_stage")
fi
shell_layout_mount=()
if [[ -n $shell_layout_js ]]; then
	shell_layout_mount+=("--rodir=/run/shell-layout=$(dirname -- "$shell_layout_js")")
fi
set +e
vm_command=(nice -n 15)
if [[ $interactive == 0 ]]; then
	vm_command+=(timeout 180s)
fi
systemd_args=()
if [[ $test_case == service-gpu ]]; then
	systemd_args+=(--systemd -a systemd.unit=multi-user.target)
fi
display=egl-headless,gl=on
vnc_args=()
if [[ $interactive == 1 ]]; then
	vnc_args+=(-q=-L -q="$packaging_root/sources/qemu/pc-bios" -q=-vnc -q=127.0.0.1:1)
	printf 'Guest desktop VNC: localhost:5901\n'
fi
"${vm_command[@]}" "$script_dir/virtme-egl-run" \
	--force-9p --disable-microvm --mods auto --show-boot-console \
	"${systemd_args[@]}" \
	--kimg "$kernel_image" --memory "$guest_memory" --cpus 4 --net user \
	"${qemu_args[@]}" \
	--rwdir="/run/results=$results" \
	--rodir="/run/kernel-build=$kernel_build" \
	--rodir="/run/extension=$stage" \
	--rodir="/run/mutter-source=$mutter_source" \
	--rodir="/run/mutter-build=$mutter_build" \
	"${renderer_mount[@]}" \
	"${pronk_bin_mount[@]}" \
	"${mesa_mount[@]}" \
	"${shell_layout_mount[@]}" \
	--rodir="/run/pronk-source=$pronk_source" \
	--rodir="/run/test=$script_dir" \
	-a kunit.enable=0 -a vkms.create_default_dev=0 -a "drm.debug=$drm_debug" \
	-q=-device -q="$gpu_device" \
	-q=-display -q="$display" \
	"${vnc_args[@]}" \
	--script-sh "$guest_command" >>"$log" 2>&1
status=$?
set -e
printf '\nHost virgl GBM layout: %s\nMutter copy mode: %s\nReceiver: %s\n' \
	"$VIRGL_GBM_LAYOUT_ENABLE" "$copy_mode" "${receiver:-none}" >>"$log"
if ((status != 0)); then
	tail -100 "$log" >&2
	exit "$status"
fi
if [[ $interactive == 1 ]]; then
	printf 'Interactive guest session ended\n'
	exit 0
fi
case $test_case in
media|media-gpu) pass='PASS: live Mutter scene through broker' ;;
gpu-capture) pass='PASS: changing nonblack Mutter pixels reached GPU-owned destinations' ;;
service-gpu) pass='PASS: installed Pronk services sustained GPU capture and VA H.264 media' ;;
esac
grep -Fq "$pass" "$log" || {
	tail -100 "$log" >&2
	exit 1
}
if [[ $test_case == media-gpu ]]; then
	grep -Fq 'PASS: GPU renderer, DMA-BUF PipeWire transport and VA H.264 encoder' "$log" || {
		tail -100 "$log" >&2
		exit 1
	}
fi
if [[ ($test_case == media || $test_case == media-gpu) && -n $receiver ]]; then
	grep -Fq 'PASS: receiver acknowledged the captured stream' "$log" || {
		tail -100 "$log" >&2
		exit 1
	}
fi
if grep -Eq 'BUG:|Oops|Call Trace:|WARNING:' "$log"; then
	printf 'guest kernel reported a failure; inspect %s\n' "$log" >&2
	exit 1
fi
if [[ $test_case == gpu-capture ]]; then
    printf 'PASS: VM assembly captured changing GPU-owned pixels\n'
elif [[ $test_case == service-gpu ]]; then
	printf 'PASS: VM Pronk services sustained GPU capture and VA H.264 media\n'
else
    printf 'PASS: VM assembly produced changing decoded frames\n'
fi
