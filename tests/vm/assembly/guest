#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later

set -eux

test "$#" -eq 4
crtc_id=$1
connector_id=$2
width=$3
height=$4
test -f /run/extension/usr/lib/pronk-sysext/manifest
test_dir=/run/pronk-source/target/debug
if test "${PRONK_VM_USE_PRONK_BIN:-0}" = 1; then
	test_dir=/run/pronk-bin
fi
case ${PRONK_VM_TEST:-media} in
media) test -x "$test_dir/pronk-capture-mutter-media-live-test" ;;
gpu-capture) test -x "$test_dir/pronk-capture-mutter-gpu-live-test" ;;
*) exit 2 ;;
esac
export PRONK_VM_TEST_DIR=$test_dir

if test -f /run/kernel-build/fs/overlayfs/overlay.ko; then
	insmod /run/kernel-build/fs/overlayfs/overlay.ko
fi
mount -t overlay overlay -o lowerdir=/run/extension/usr:/usr /usr
if ! grep -Fqx "HOST_KERNEL_RELEASE=$(uname -r)" \
	/usr/lib/pronk-sysext/manifest; then
	if test "${PRONK_VM_ALLOW_KERNEL_RELEASE_MISMATCH:-0}" != 1; then
		printf 'staged extension targets another kernel release\n' >&2
		exit 1
	fi
	printf 'note: staged extension targets a different kernel release\n' >&2
fi

udevadm settle
mkdir -p /run/udev/rules.d
cp /run/test/61-pronk-vm-gpu.rules /run/udev/rules.d/
udevadm control --reload
udevadm trigger --subsystem-match=drm
udevadm settle

castkms_card=
for card in /dev/dri/card[0-9]*; do
	udevadm info --query=property --name="$card" \
		> "/run/results/udev-${card##*/}.log" 2>&1 || :
	if grep -Fq 'DEVPATH=/devices/faux/castkms/drm/' \
		"/run/results/udev-${card##*/}.log"; then
		castkms_card=$card
		break
	fi
done
test -n "$castkms_card"
test -e /dev/dri/renderD128
test -e /dev/dma_heap/system
printf 'CastKMS card: %s\n' "$castkms_card"

export CASTKMS_RENDERER_CARD=$castkms_card
export CASTKMS_RENDER_NODE=/dev/dri/renderD128
export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/virtio_icd.x86_64.json
export MUTTER_DEBUG_MULTI_GPU_FORCE_COPY_MODE=${PRONK_VM_COPY_MODE:-primary-gpu-cpu}
export MUTTER_DEBUG_DISABLE_ANIMATIONS=1
export MUTTER_DEBUG_FORCE_KMS_MODE=atomic
export MUTTER_DEBUG_KMS_THREAD_TYPE=user
export MUTTER_DEBUG_USE_KMS_MODIFIERS=1
export MUTTER_DEBUG=kms
export GSETTINGS_SCHEMA_DIR=/usr/share/glib-2.0/schemas
export LD_LIBRARY_PATH=/usr/lib64/mutter-51
if test "${PRONK_VM_USE_MUTTER_BUILD:-0}" = 1; then
	test -f /run/mutter-build/src/libmutter-51.so.0.0.0
	export LD_LIBRARY_PATH=/run/mutter-build/src:/run/mutter-build/clutter/clutter:/run/mutter-build/cogl/cogl:/run/mutter-build/mtk/mtk:$LD_LIBRARY_PATH
	printf 'Using Mutter library from /run/mutter-build/src\n'
fi
if test "${PRONK_VM_USE_MESA_STAGE:-0}" = 1; then
	test -f /run/mesa-stage/usr/local/lib64/libgallium-26.2.2.so
	export LD_LIBRARY_PATH=/run/mesa-stage/usr/local/lib64:$LD_LIBRARY_PATH
	export GBM_BACKENDS_PATH=/run/mesa-stage/usr/local/lib64/gbm
	printf 'Using Mesa libraries from /run/mesa-stage\n'
fi
export META_DBUS_RUNNER_DISABLE_LOGIND_PASSTHROUGH=1
unset GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE VN_PERF ZINK_DEBUG
unset LIBGL_ALWAYS_SOFTWARE MUTTER_DEBUG_USE_FBOS
if test "${PRONK_VM_USE_FBOS:-auto}" != auto; then
	export MUTTER_DEBUG_USE_FBOS=$PRONK_VM_USE_FBOS
fi
unset DBUS_SESSION_BUS_ADDRESS DBUS_SYSTEM_BUS_ADDRESS

renderer=/usr/libexec/castkms/castkms-rendererd
if test -x /run/renderer-build/castkms-rendererd; then
	renderer=/run/renderer-build/castkms-rendererd
fi
RUST_LOG=debug "$renderer" \
	> /run/results/renderer.log 2>&1 &
renderer_pid=$!
trap 'kill "$renderer_pid" 2>/dev/null || :; wait "$renderer_pid" 2>/dev/null || :' EXIT

cd /run/mutter-source
export G_TEST_SRCDIR=$PWD/src/tests
export G_TEST_BUILDDIR=/run/mutter-build/src/tests
if python3 src/tests/meta-dbus-runner.py -- \
	sh /run/test/session "$castkms_card" "$crtc_id" "$connector_id" \
	"$width" "$height"; then
	result=0
else
	result=$?
fi
dmesg > /run/results/kernel.log
exit "$result"
