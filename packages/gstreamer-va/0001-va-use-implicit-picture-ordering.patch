From 4052ef686cdf444dcdb223710cb6b98ab70bcc02 Mon Sep 17 00:00:00 2001
From: Ray Strode <rstrode@redhat.com>
Date: Mon, 28 Sep 2026 17:55:28 -0400
Subject: [PATCH] va: Use implicit picture ordering without B-frames

H.264 picture-order-count type 0 explicitly signals picture order even
when the VA encoder emits only reference pictures in display order.
Some Cast receivers add presentation delay to those streams despite a
zero reorder limit.

This commit selects type 2 for reference-using streams without B-frames.
Picture order then follows frame numbers. The sequence parameters and
packed SPS share the selection, and the slice writer omits the explicit
order fields accordingly. Streams with B-frames and intra-only streams
retain type 0.
---
 sys/va/gstvah264enc.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/sys/va/gstvah264enc.c b/sys/va/gstvah264enc.c
index debb5ec..82406f2 100644
--- a/sys/va/gstvah264enc.c
+++ b/sys/va/gstvah264enc.c
@@ -2095,8 +2095,8 @@ _fill_sps (GstVaH264Enc * self, VAEncSequenceParameterBufferH264 * seq_param)
 
   /* seq_scaling_matrix_present_flag not supported now */
   g_assert (seq_param->seq_fields.bits.seq_scaling_matrix_present_flag == 0);
-  /* pic_order_cnt_type only support 0 now */
-  g_assert (seq_param->seq_fields.bits.pic_order_cnt_type == 0);
+  g_assert (seq_param->seq_fields.bits.pic_order_cnt_type == 0 ||
+      seq_param->seq_fields.bits.pic_order_cnt_type == 2);
   /* only progressive frames encoding is supported now */
   g_assert (seq_param->seq_fields.bits.frame_mbs_only_flag);
 
@@ -2251,7 +2251,8 @@ _fill_sequence_param (GstVaH264Enc * self,
       .seq_scaling_matrix_present_flag = FALSE,
       .direct_8x8_inference_flag = direct_8x8_inference_flag,
       .log2_max_frame_num_minus4 = self->gop.log2_max_frame_num - 4,
-      .pic_order_cnt_type = 0,
+      .pic_order_cnt_type = self->gop.num_bframes == 0 &&
+          self->gop.num_ref_frames > 0 ? 2 : 0,
       .log2_max_pic_order_cnt_lsb_minus4 = self->gop.log2_max_pic_order_cnt - 4,
     },
     .bit_depth_luma_minus8 = 0,
@@ -2736,7 +2737,7 @@ _add_slice_header (GstVaH264Enc * self, GstVaH264EncFrame * frame,
     .field_pic_flag = 0,
     .bottom_field_flag = 0,
     .idr_pic_id = (frame->frame_num == 0 ? slice->idr_pic_id : 0),
-    /* only pic_order_cnt_type 1 is supported now. */
+    /* Written only when the SPS selects picture-order-count type 0. */
     .pic_order_cnt_lsb = slice->pic_order_cnt_lsb,
     .delta_pic_order_cnt_bottom = slice->delta_pic_order_cnt_bottom,
      /* Only for B frame. */

