#!/bin/sh
# SPDX-License-Identifier: MIT

set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT HUP INT TERM

cc -std=c11 -Wall -Wextra -Werror \
  -I"$root/sources/castkms/include/uapi" \
  -I/usr/include/libdrm \
  "$root/scripts/probes/castkms-uapi-layout.c" \
  -o "$temporary/castkms-uapi-layout"
"$temporary/castkms-uapi-layout" >"$temporary/c-layout"

cargo run --quiet --locked \
  --manifest-path "$root/sources/pronk/Cargo.toml" \
  -p castkms-sys --example uapi-layout >"$temporary/rust-layout"

if ! diff -u "$temporary/c-layout" "$temporary/rust-layout"; then
  echo "CastKMS C and Rust UAPI layouts differ" >&2
  exit 1
fi

echo "CastKMS C and Rust UAPI layouts match"
