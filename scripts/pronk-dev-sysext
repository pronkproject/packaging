#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
packaging_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)

pronk_source=$packaging_root/sources/pronk
castkms_source=$packaging_root/sources/castkms
mutter_source=$packaging_root/sources/mutter
control_center_source=$packaging_root/sources/gnome-control-center
wireplumber_source=$packaging_root/sources/wireplumber
gvc_source=$packaging_root/sources/libgnome-volume-control
gvdb_source=$packaging_root/sources/gvdb
libgxdp_source=$packaging_root/sources/libgxdp
gsettings_source=$packaging_root/sources/gsettings-desktop-schemas
gtk_source=$packaging_root/sources/gtk
accountsservice_source=$packaging_root/sources/accountsservice
gnome_desktop_source=$packaging_root/sources/gnome-desktop
qrcodegen_source=$packaging_root/sources/qrcodegen

state_base=${XDG_STATE_HOME:-$HOME/.local/state}
data_base=${XDG_DATA_HOME:-$HOME/.local/share}
state_dir=${PRONK_SYSEXT_STATE_DIR:-$state_base/pronk-sysext}
podman_root=${PRONK_SYSEXT_PODMAN_ROOT:-$data_base/pronk-sysext/podman-root}
podman_runroot=${PRONK_SYSEXT_PODMAN_RUNROOT:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pronk-sysext/podman-runroot}
extension_store=${PRONK_SYSEXT_STORE:-/var/lib/pronk-sysext}

run_tests=false
rebuild_builder=false
temporary_stage=
pending_installed_image=

cleanup_temporary_stage()
{
	[[ -n $temporary_stage && -d $temporary_stage ]] || return 0
	case $temporary_stage in
	"$state_dir"/.stage.*)
		rm -rf --one-file-system -- "$temporary_stage"
		;;
	*)
		printf 'warning: refusing to remove unexpected temporary stage: %s\n' \
			"$temporary_stage" >&2
		;;
	esac
}

cleanup_pending_installed_image()
{
	[[ -n $pending_installed_image ]] || return 0
	case $pending_installed_image in
	"$extension_store"/images/.pending.*)
		sudo rm -rf --one-file-system -- "$pending_installed_image" || \
			printf 'warning: could not remove pending image: %s\n' \
				"$pending_installed_image" >&2
		;;
	*)
		printf 'warning: refusing to remove unexpected pending image: %s\n' \
			"$pending_installed_image" >&2
		;;
	esac
}

cleanup_on_exit()
{
	local status=$?

	cleanup_temporary_stage
	cleanup_pending_installed_image
	return "$status"
}

trap cleanup_on_exit EXIT

log()
{
	printf '==> %s\n' "$*"
}

die()
{
	printf 'error: %s\n' "$*" >&2
	exit 1
}

usage()
{
	cat <<EOF
Usage: scripts/pronk-dev-sysext [OPTIONS] COMMAND

Build and deploy the Pronk userspace stack as a systemd system extension.
Source builds happen in a dedicated rootless Podman image; only runtime files
are installed on the host.

Commands:
  prepare   Create or update the persistent build image
  build     Build all components into a local extension staging directory
  install   Publish the staged extension for activation at the next boot
  deploy    Run prepare, build, and install
  activate  Merge an installed extension without rebooting when safe
  status    Show compatibility, merge, kernel, and service state
  check     Check the deployment scripts without changing the system

Options:
  --run-tests        Run source-tree test gates while building
  --rebuild-builder  Rebuild the Podman image even if it already exists
  -h, --help         Show this help

Sources are always read from this packaging checkout's sources/* submodules.
Dirty submodule worktrees are supported for local whole-stack experiments.
EOF
}

strip_quotes()
{
	local value=$1
	case $value in
	\"*\") value=${value#\"}; value=${value%\"} ;;
	\'*) value=${value#\'}; value=${value%\'} ;;
	esac
	printf '%s\n' "$value"
}

read_value()
{
	local file=$1
	local key=$2
	local line

	while IFS= read -r line || [[ -n $line ]]; do
		case $line in
		"$key="*)
			strip_quotes "${line#*=}"
			return 0
			;;
		esac
	done < "$file"

	return 1
}

require_command()
{
	command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

require_source_tree()
{
	local name=$1
	local path=$2

	[[ -d $path ]] || die "$name source tree is missing: $path"
}

require_git_source_tree()
{
	local name=$1
	local path=$2
	local top

	require_source_tree "$name" "$path"
	top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null) || \
		die "$name submodule is not initialized: $path"
	[[ $top == "$path" ]] || die "$name submodule is not initialized: $path"
}

require_source_bundle()
{
	require_command git
	require_git_source_tree Pronk "$pronk_source"
	require_git_source_tree CastKMS "$castkms_source"
	require_git_source_tree Mutter "$mutter_source"
	require_git_source_tree 'GNOME Settings' "$control_center_source"
	require_git_source_tree WirePlumber "$wireplumber_source"
	require_git_source_tree libgnome-volume-control "$gvc_source"
	require_git_source_tree GVDB "$gvdb_source"
	require_git_source_tree libgxdp "$libgxdp_source"
	require_git_source_tree gsettings-desktop-schemas "$gsettings_source"
	require_git_source_tree GTK "$gtk_source"
	require_git_source_tree AccountsService "$accountsservice_source"
	require_git_source_tree GNOME-desktop "$gnome_desktop_source"
	require_git_source_tree QR-Code-generator "$qrcodegen_source"
}

host_id()
{
	if [[ -n ${PRONK_HOST_ID:-} ]]; then
		printf '%s\n' "$PRONK_HOST_ID"
	else
		read_value /usr/lib/os-release ID
	fi
}

host_version_id()
{
	if [[ -n ${PRONK_HOST_VERSION_ID:-} ]]; then
		printf '%s\n' "$PRONK_HOST_VERSION_ID"
	else
		read_value /usr/lib/os-release VERSION_ID
	fi
}

running_host_matches_target()
{
	local running_id
	local running_version

	running_id=$(read_value /usr/lib/os-release ID)
	running_version=$(read_value /usr/lib/os-release VERSION_ID)
	[[ $(host_id) == "$running_id" && $(host_version_id) == "$running_version" ]]
}

host_ostree_version()
{
	local ostree_version

	if [[ -n ${PRONK_HOST_OSTREE_VERSION:-} ]]; then
		printf '%s\n' "$PRONK_HOST_OSTREE_VERSION"
	elif ostree_version=$(read_value /usr/lib/os-release OSTREE_VERSION); then
		printf '%s\n' "$ostree_version"
	else
		printf 'non-ostree:%s-%s\n' "$(host_id)" "$(host_version_id)"
	fi
}

kernel_release()
{
	uname -r
}

require_pinned_castkms_kernel()
{
	local release
	local revision

	revision=$(git_head_revision "$castkms_source")
	release=$(kernel_release)
	[[ $release == *"-pronk-g$revision" ]] ||
		die "the running kernel does not match CastKMS revision $revision: $release"
	castkms_is_available || die 'the running kernel does not provide CastKMS'
}

safe_component()
{
	local value=$1
	[[ $value =~ ^[A-Za-z0-9._-]+$ ]] || die "unsafe path component: $value"
}

ensure_state_directories()
{
	case $state_dir in
	/|"$HOME"|"")
		die "refusing unsafe state directory: $state_dir"
		;;
	esac
	mkdir -p -- \
		"$state_dir/builds" \
		"$state_dir/cargo" \
		"$podman_root" \
		"$podman_runroot"
}

jobs()
{
	local processors
	local memory_kib
	local memory_jobs
	local selected

	if [[ -n ${PRONK_BUILD_JOBS:-} ]]; then
		[[ $PRONK_BUILD_JOBS =~ ^[1-9][0-9]*$ ]] || die 'PRONK_BUILD_JOBS must be a positive integer'
		printf '%s\n' "$PRONK_BUILD_JOBS"
		return
	fi

	processors=$(nproc)
	memory_kib=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
	memory_jobs=$((memory_kib / 2097152))
	((memory_jobs > 0)) || memory_jobs=1
	selected=$processors
	((selected <= memory_jobs)) || selected=$memory_jobs
	((selected <= 8)) || selected=8
	printf '%s\n' "$selected"
}

podman_cmd()
{
	podman --root "$podman_root" --runroot "$podman_runroot" "$@"
}

builder_image()
{
	local definition_hash
	definition_hash=$(sha256sum "$script_dir/sysext/Containerfile")
	definition_hash=${definition_hash%% *}
	printf 'localhost/pronk-sysext-builder:f%s-%s\n' \
		"$(host_version_id)" "${definition_hash:0:12}"
}

builder_exists()
{
	podman_cmd image exists "$(builder_image)"
}

builder_identity()
{
	podman_cmd image inspect --format '{{.Id}}' "$(builder_image)"
}

prepare_builder()
{
	local image

	require_command podman
	ensure_state_directories

	image=$(builder_image)

	if builder_exists && ! $rebuild_builder; then
		log "Build image is ready: $image"
	else
		log "Building persistent Fedora $(host_version_id) toolchain image"
		podman_cmd build \
			--build-arg "FEDORA_VERSION=$(host_version_id)" \
			--tag "$image" \
			--file "$script_dir/sysext/Containerfile" \
			"$script_dir/sysext"
	fi
}

run_in_builder()
{
	local image_identity
	local parallelism
	local -a source_volumes
	image_identity=$(builder_identity)
	parallelism=$(jobs)
	source_volumes=(
		--volume "$packaging_root:$packaging_root:rw"
		--volume "$state_dir:$state_dir:rw"
		# Present the separately pinned archive supplements where Meson expects
		# its fallback subprojects, without modifying either source checkout.
		--volume "$gvdb_source:$mutter_source/subprojects/gvdb:ro"
		--volume "$gvc_source:$control_center_source/subprojects/gvc:ro"
		--volume "$libgxdp_source:$control_center_source/subprojects/libgxdp:ro"
	)

	podman_cmd run --rm \
		--userns=keep-id \
		--user "$(id -u):$(id -g)" \
		--security-opt label=disable \
		"${source_volumes[@]}" \
		--workdir "$packaging_root" \
		--env "CARGO_HOME=$state_dir/cargo" \
		--env "CARGO_BUILD_JOBS=$parallelism" \
		--env "PRONK_BUILD_JOBS=$parallelism" \
		--env "PRONK_SYSEXT_STATE_DIR=$state_dir" \
		--env "PRONK_HOST_ID=$(host_id)" \
		--env "PRONK_HOST_VERSION_ID=$(host_version_id)" \
		--env "PRONK_HOST_OSTREE_VERSION=$(host_ostree_version)" \
		--env "PRONK_BUILDER_IDENTITY=$image_identity" \
		"$(builder_image)" \
		"$@"
}

git_revision()
{
	local tree=$1
	local revision
	local status

	revision=$(git_head_revision "$tree")
	status=$(git -C "$tree" status --porcelain --untracked-files=normal \
		--ignore-submodules=all) || {
		printf 'error: cannot inspect the Git worktree at %s\n' "$tree" >&2
		return 1
	}
	if [[ -n $status ]]; then
		revision+="-dirty"
	fi
	printf '%s\n' "$revision"
}

git_head_revision()
{
	local tree=$1
	local revision

	revision=$(git -C "$tree" rev-parse --short=12 HEAD 2>/dev/null) || {
		printf 'error: cannot read the Git revision for %s\n' "$tree" >&2
		return 1
	}
	printf '%s\n' "$revision"
}

build_id()
{
	local pronk_revision=$1

	printf '%s-%s\n' "$(date -u +%Y%m%dT%H%M%S%NZ)" "$pronk_revision"
}

discard_managed_build()
{
	local build_dir=$1

	case $build_dir in
	"$state_dir"/builds/*)
		rm -rf --one-file-system -- "$build_dir"
		;;
	*)
		die "refusing to remove unexpected build directory: $build_dir"
		;;
	esac
}

reset_build_if_incompatible()
{
	local build_dir=$1
	local build_context=${2:-default}
	local stamp=$build_dir/.pronk-build-host
	local expected
	local actual=
	printf -v expected '%s\n%s\n%s' \
		"$(host_ostree_version)" \
		"${PRONK_BUILDER_IDENTITY:-$(builder_image)}" \
		"$build_context"

	if [[ -d $build_dir ]]; then
		[[ ! -r $stamp ]] || actual=$(<"$stamp")
		if [[ $actual != "$expected" ]]; then
			log "Discarding build products from another deployment: $build_dir"
			discard_managed_build "$build_dir"
		fi
	fi

	mkdir -p -- "$build_dir"
	printf '%s\n' "$expected" > "$stamp"
}

meson_configure()
{
	local source=$1
	local build=$2
	shift 2

	reset_build_if_incompatible "$build" "meson:$source:${PRONK_MESON_CONTEXT:-}"
	# A failed Meson setup leaves meson-private behind but no usable Ninja
	# graph. Start that managed build directory afresh on the next attempt.
	if [[ ! -f $build/build.ninja && -d $build/meson-private ]]; then
		log "Discarding an incomplete Meson setup: $build"
		discard_managed_build "$build"
		reset_build_if_incompatible "$build" "meson:$source:${PRONK_MESON_CONTEXT:-}"
	fi
	if [[ -f $build/build.ninja ]]; then
		# A staged dependency has a different prefix for every temporary
		# extension. Clear Meson's dependency cache before reconfiguring so a
		# reused build directory does not retain the previous stage's headers.
		meson setup --wrap-mode=nodownload --clearcache --reconfigure "$build" "$source" "$@"
	else
		meson setup --wrap-mode=nodownload "$build" "$source" "$@"
	fi
}

build_wireplumber()
{
	local stage=$1
	local build=$state_dir/builds/wireplumber

	log 'Building WirePlumber'
	meson_configure "$wireplumber_source" "$build" \
		--prefix=/usr \
		--libdir=lib64 \
		--buildtype=debugoptimized \
		-Dsystem-lua=true \
		-Ddoc=disabled \
		-Dsystemd=enabled \
		-Dsystemd-user-service=true \
		-Dintrospection=enabled \
		-Delogind=disabled \
		-Dtests="$run_tests" \
		-Ddbus-tests="$run_tests"
	meson compile -C "$build" -j "$(jobs)"
	if $run_tests; then
		meson test -C "$build" --print-errorlogs
	fi
	DESTDIR="$stage" meson install -C "$build" --no-rebuild

	# Keep the same runtime surface as Fedora's wireplumber and
	# wireplumber-libs packages; development files do not belong in the image.
	rm -rf -- \
		"$stage/usr/include/wireplumber-0.5" \
		"$stage/usr/share/doc/wireplumber"
	rm -f -- \
		"$stage/usr/lib64/libwireplumber-0.5.so" \
		"$stage/usr/lib64/pkgconfig/wireplumber-0.5.pc" \
		"$stage/usr/share/gir-1.0/Wp-0.5.gir"

	# A system extension intentionally merges /usr and /opt only. Any empty
	# system configuration directories are already supplied by the base image.
	rm -rf -- "${stage:?}/etc" "${stage:?}/var"
}

stage_video_encoder_runtime()
{
	local stage=$1
	local package_dir=$stage/.runtime-packages
	local package_name
	local package_path
	local candidate
	local -a candidates
	local -a package_names=(
		gstreamer1-plugins-ugly
		x264-libs
	)

	require_command dnf
	require_command rpm
	require_command rpm2cpio
	mkdir -p -- "$package_dir"
	log 'Downloading the GStreamer H.264 encoder runtime'
	dnf -q download \
		--refresh \
		--releasever="$(host_version_id)" \
		--arch="$(uname -m)" \
		--destdir="$package_dir" \
		"${package_names[@]}"

	for package_name in "${package_names[@]}"; do
		candidates=()
		while IFS= read -r -d '' candidate; do
			if [[ $(rpm -qp --qf '%{NAME}' "$candidate") == "$package_name" ]]; then
				candidates+=("$candidate")
			fi
		done < <(find "$package_dir" -maxdepth 1 -type f -name '*.rpm' -print0)
		((${#candidates[@]} == 1)) || \
			die "expected one downloaded $package_name RPM, found ${#candidates[@]}"
		package_path=${candidates[0]}
		log "Staging $(basename "$package_path")"
		rpm2cpio "$package_path" | (cd "$stage" && cpio -idmu --quiet)
	done

	rm -rf --one-file-system -- "${package_dir:?}"
}

build_gsettings_desktop_schemas()
{
	local stage=$1
	local build=$state_dir/builds/gsettings-desktop-schemas

	log 'Building GNOME desktop schemas'
	meson_configure "$gsettings_source" "$build" \
		--prefix=/usr \
		--libdir=lib64 \
		--buildtype=debugoptimized
	meson compile -C "$build" -j "$(jobs)"
	DESTDIR="$stage" meson install -C "$build" --no-rebuild
	glib-compile-schemas --strict "$stage/usr/share/glib-2.0/schemas"
}

build_gtk4()
{
	local stage=$1
	local build=$state_dir/builds/gtk4
	local pc

	log 'Building GTK 4.23'
	meson_configure "$gtk_source" "$build" \
		--prefix=/usr \
		--libdir=lib64 \
		--buildtype=debugoptimized \
		-Ddocumentation=false \
		-Dintrospection=enabled \
		-Dman-pages=false \
		-Dbuild-tests=false \
		-Dbuild-testsuite=false \
		-Dbuild-demos=false \
		-Dbuild-examples=false
	meson compile -C "$build" -j "$(jobs)"
	DESTDIR="$stage" meson install -C "$build" --no-rebuild

	# Consumers configure against this staged GTK rather than Fedora 44's
	# older system copy. The development metadata is removed after those builds.
	for pc in "$stage"/usr/lib64/pkgconfig/gtk4*.pc \
		"$stage"/usr/lib64/pkgconfig/gdk-*.pc; do
		[[ -f $pc ]] || continue
		sed -i "s|^prefix=/usr$|prefix=$stage/usr|" "$pc"
	done
}

build_gnome_desktop()
(
	local stage=$1
	local build=$state_dir/builds/gnome-desktop

	log 'Building GNOME desktop 51'
	local qrcodegen_link=$gnome_desktop_source/subprojects/qrcodegen
	local qrcodegen_build_source=$state_dir/builds/gnome-desktop-qrcodegen
	local wraplock=$gnome_desktop_source/subprojects/.wraplock
	[[ ! -e $qrcodegen_link ]] || die "unexpected GNOME desktop qrcodegen path: $qrcodegen_link"
	rm -rf --one-file-system -- "$qrcodegen_build_source"
	mkdir -p "$qrcodegen_build_source"
	cp -a "$qrcodegen_source"/. "$qrcodegen_build_source"/
	cp -a "$gnome_desktop_source/subprojects/packagefiles/qrcodegen"/. \
		"$qrcodegen_build_source"/
	ln -s "$qrcodegen_build_source" "$qrcodegen_link"
	trap 'rm -f -- "$qrcodegen_link" "$wraplock"' EXIT
	PRONK_MESON_CONTEXT="$stage" \
	PKG_CONFIG_PATH="$stage/usr/lib64/pkgconfig:$stage/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
		meson_configure "$gnome_desktop_source" "$build" \
			--prefix=/usr \
			--libdir=lib64 \
			--libexecdir=libexec \
			--buildtype=debugoptimized \
			-Dgtk_doc=false \
			-Dinstalled_tests=false
	meson compile -C "$build" -j "$(jobs)"
	DESTDIR="$stage" meson install -C "$build" --no-rebuild
	for pc in "$stage"/usr/lib64/pkgconfig/gnome-*-4.pc; do
		[[ -f $pc ]] || continue
		sed -i "s|^prefix=/usr$|prefix=$stage/usr|" "$pc"
	done
)

build_accountsservice()
(
	local stage=$1
	local build=$state_dir/builds/accountsservice
	local wraplock=$accountsservice_source/subprojects/.wraplock
	local mocklibc_source=$accountsservice_source/subprojects/mocklibc-1.0
	local test_pycache=$accountsservice_source/tests/__pycache__

	# Meson materializes the locally declared mocklibc subproject while it
	# configures AccountsService. Keep the source checkout clean after a build.
	trap 'rm -rf -- "$wraplock" "$mocklibc_source" "$test_pycache"' EXIT
	log 'Building AccountsService 26.27.3'
	meson_configure "$accountsservice_source" "$build" \
		--prefix=/usr \
		--libdir=lib64 \
		--libexecdir=libexec \
		--buildtype=debugoptimized \
		-Dgtk_doc=false \
		-Dadmin_group=wheel
	meson compile -C "$build" -j "$(jobs)"
	DESTDIR="$stage" meson install -C "$build" --no-rebuild
	# AccountsService creates empty mutable runtime-state directories while
	# installing. They belong to the host's /var and cannot be part of a sysext.
	rm -rf --one-file-system -- "${stage:?}/var"
	sed -i "s|^prefix=/usr$|prefix=$stage/usr|" \
		"$stage/usr/lib64/pkgconfig/accountsservice.pc"
)

build_mutter()
{
	local stage=$1
	local build=$state_dir/builds/mutter

	log 'Building Mutter with the CastKMS grant broker'
	PRONK_MESON_CONTEXT="$stage" \
	PKG_CONFIG_PATH="$stage/usr/lib64/pkgconfig:$stage/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
		meson_configure "$mutter_source" "$build" \
		--prefix=/usr \
		--libdir=lib64 \
		--libexecdir=libexec \
		--buildtype=debugoptimized \
		-Dtests=disabled \
		-Dinstalled_tests=false \
		-Ddocs=false
	meson compile -C "$build" -j "$(jobs)"
	DESTDIR="$stage" meson install -C "$build" --no-rebuild
}

build_control_center()
{
	local stage=$1
	local build=$state_dir/builds/gnome-control-center

	log 'Building GNOME Settings with the Casting panel'
	PRONK_MESON_CONTEXT="$stage" \
	PKG_CONFIG_PATH="$stage/usr/lib64/pkgconfig:$stage/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
	GI_TYPELIB_PATH="$stage/usr/lib64/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}" \
		meson_configure "$control_center_source" "$build" \
		--prefix=/usr \
		--libdir=lib64 \
		--libexecdir=libexec \
		--buildtype=debugoptimized \
		-Dtests=false \
		-Ddocumentation=false
	GI_TYPELIB_PATH="$stage/usr/lib64/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}" \
		meson compile -C "$build" -j "$(jobs)"
	DESTDIR="$stage" meson install -C "$build" --no-rebuild
}

trim_gnome_desktop_devel()
{
	local stage=$1

	rm -rf -- "$stage/usr/include/gnome-desktop-4.0"
	rm -f -- "$stage"/usr/lib64/libgnome-*-4.so \
		"$stage"/usr/lib64/pkgconfig/gnome-*-4.pc \
		"$stage"/usr/lib64/girepository-1.0/Gnome*-4.0.typelib \
		"$stage"/usr/share/gir-1.0/Gnome*-4.0.gir
}

trim_accountsservice_devel()
{
	local stage=$1

	# Fedora supplies the system AccountsService daemon.  This extension only
	# needs the newer client ABI used by the GNOME 51 applications.  Shipping
	# the daemon's D-Bus activation and policy files would replace host files
	# from /var/lib, which carries the wrong SELinux label after a plain
	# directory deployment and prevents dbus-broker from starting.
	rm -f -- "$stage/usr/libexec/accounts-daemon" \
		"$stage/usr/lib/systemd/system/accounts-daemon.service" \
		"$stage/usr/share/dbus-1/interfaces/org.freedesktop.Accounts.xml" \
		"$stage/usr/share/dbus-1/interfaces/org.freedesktop.Accounts.User.xml" \
		"$stage/usr/share/dbus-1/system.d/org.freedesktop.Accounts.conf" \
		"$stage/usr/share/dbus-1/system-services/org.freedesktop.Accounts.service" \
		"$stage/usr/share/polkit-1/actions/org.freedesktop.accounts.policy"
	rm -rf -- "$stage/usr/share/accountsservice"

	rm -rf -- "$stage/usr/include/accountsservice-1.0" \
		"$stage/usr/share/gtk-doc/html/libaccountsservice" \
		"$stage/usr/share/vala/vapi"
	rm -f -- "$stage/usr/lib64/libaccountsservice.so" \
		"$stage/usr/lib64/pkgconfig/accountsservice.pc" \
		"$stage/usr/lib64/girepository-1.0/AccountsService-1.0.typelib" \
		"$stage/usr/share/gir-1.0/AccountsService-1.0.gir"
}

trim_gtk4_devel()
{
	local stage=$1

	rm -rf -- "$stage/usr/include/gtk-4.0"
	rm -f -- "$stage"/usr/lib64/pkgconfig/gtk4*.pc \
		"$stage"/usr/lib64/pkgconfig/gdk-*.pc \
		"$stage"/usr/lib64/girepository-1.0/Gtk-4.0.typelib \
		"$stage"/usr/share/gir-1.0/Gtk-4.0.gir
}

trim_gsettings_desktop_schemas_devel()
{
	local stage=$1

	# The schemas are needed at runtime, while their headers and introspection
	# metadata only serve the Mutter build in this container.
	rm -rf -- "$stage/usr/include/gsettings-desktop-schemas"
	rm -f -- \
		"$stage/usr/lib64/girepository-1.0/GDesktopEnums-3.0.typelib" \
		"$stage/usr/share/gir-1.0/GDesktopEnums-3.0.gir" \
		"$stage/usr/share/pkgconfig/gsettings-desktop-schemas.pc"
}

build_pronk()
{
	local stage=$1
	local build=$state_dir/builds/pronk

	log 'Building Pronk and its Chromiacast backend'
	PRONK_MESON_CONTEXT="$stage" \
	PATH="$stage/usr/bin:$PATH" \
	LD_LIBRARY_PATH="$stage/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
		meson_configure "$pronk_source" "$build" \
			--prefix=/usr \
			--libdir=lib64 \
			--libexecdir=libexec
	meson compile -C "$build" -j "$(jobs)"
	if $run_tests; then
		(
			local test_runtime
			test_runtime=$(mktemp -d "$state_dir/.test-runtime.XXXXXX")
			trap 'rm -rf --one-file-system -- "$test_runtime"' EXIT
			chmod 0700 "$test_runtime"
			PATH="$stage/usr/bin:$PATH" \
			LD_LIBRARY_PATH="$stage/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
			GST_PLUGIN_PATH="$stage/usr/lib64/gstreamer-1.0${GST_PLUGIN_PATH:+:$GST_PLUGIN_PATH}" \
			XDG_DATA_DIRS="$stage/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}" \
			WIREPLUMBER_MODULE_DIR="$stage/usr/lib64/wireplumber-0.5" \
			XDG_RUNTIME_DIR="$test_runtime" \
				dbus-run-session -- \
				meson test -C "$build" --print-errorlogs
		)
	fi
	DESTDIR="$stage" meson install -C "$build" --no-rebuild

	# Make discovery available without a one-time enable operation in $HOME.
	install -d "$stage/usr/lib/systemd/user/sockets.target.wants"
	ln -s ../pronk-chromiacast.socket \
		"$stage/usr/lib/systemd/user/sockets.target.wants/pronk-chromiacast.socket"
}

stage_castkms_runtime_policy()
{
	local stage=$1

	# dma_heap devices are virtual and do not inherit a seat from a parent
	# device.  Mark the system heap as belonging to the logged-in seat before
	# systemd's 73-seat-late.rules applies its uaccess ACL.  Pronk's capture
	# worker can then allocate its DMA-BUF pool without joining the broad video
	# group.
	install -D -m 0644 \
		"$script_dir/sysext/72-pronk-dma-heap.rules" \
		"$stage/usr/lib/udev/rules.d/72-pronk-dma-heap.rules"
}

write_extension_metadata()
{
	local stage=$1
	local identifier=$2
	local release_dir=$stage/usr/lib/extension-release.d
	local metadata_dir=$stage/usr/lib/pronk-sysext
	local packaging_revision=$3
	local pronk_revision=$4
	local castkms_revision=$5
	local mutter_revision=$6
	local control_center_revision=$7
	local wireplumber_revision=$8
	local gvc_revision=$9
	local gvdb_revision=${10}
	local libgxdp_revision=${11}
	local gsettings_revision=${12}
	local gtk_revision=${13}
	local accountsservice_revision=${14}
	local gnome_desktop_revision=${15}

	install -d "$release_dir" "$metadata_dir"
	printf 'ID=%s\nVERSION_ID=%s\nSYSEXT_ID=pronk\nEXTENSION_RELOAD_MANAGER=1\n' \
		"$(host_id)" "$(host_version_id)" \
		> "$release_dir/extension-release.pronk"
	printf '%s\n' \
		"BUILD_ID=$identifier" \
		"HOST_ID=$(host_id)" \
		"HOST_VERSION_ID=$(host_version_id)" \
		"HOST_OSTREE_VERSION=$(host_ostree_version)" \
		"HOST_KERNEL_RELEASE=$(kernel_release)" \
		"BUILDER_IMAGE=$(builder_image)" \
		"BUILDER_IDENTITY=${PRONK_BUILDER_IDENTITY:-unknown}" \
		"PACKAGING_REVISION=$packaging_revision" \
		"PRONK_REVISION=$pronk_revision" \
		"CASTKMS_REVISION=$castkms_revision" \
		"MUTTER_REVISION=$mutter_revision" \
		"CONTROL_CENTER_REVISION=$control_center_revision" \
		"WIREPLUMBER_REVISION=$wireplumber_revision" \
		"GVC_REVISION=$gvc_revision" \
		"GVDB_REVISION=$gvdb_revision" \
		"LIBGXDP_REVISION=$libgxdp_revision" \
		"GSETTINGS_DESKTOP_SCHEMAS_REVISION=$gsettings_revision" \
		"GTK4_REVISION=$gtk_revision" \
		"ACCOUNTS_SERVICE_REVISION=$accountsservice_revision" \
		"GNOME_DESKTOP_REVISION=$gnome_desktop_revision" \
		> "$metadata_dir/manifest"

}

validate_stage()
{
	local stage=$1
	local stage_mode
	local manifest=$stage/usr/lib/pronk-sysext/manifest
	local manifest_key
	local required
	local unexpected

	stage_mode=$(stat -c '%a' "$stage")
	[[ $stage_mode == 755 ]] ||
		die "staged extension root must be mode 0755, found $stage_mode"

	for required in \
		usr/bin/pronkd \
		usr/bin/pronkctl \
		usr/bin/gnome-control-center \
		usr/bin/wireplumber \
		usr/libexec/pronk/pronk-chromiacast \
		usr/share/glib-2.0/schemas/gschemas.compiled \
		usr/lib64/gstreamer-1.0/libgstx264.so \
		usr/lib/systemd/user/pronk-chromiacast.socket \
		usr/lib/udev/rules.d/72-pronk-dma-heap.rules \
		usr/lib/extension-release.d/extension-release.pronk \
		usr/lib/pronk-sysext/manifest; do
		[[ -e $stage/$required ]] || die "staged extension is missing /$required"
	done

	find "$stage/usr/lib64" -name 'libmutter-*.so.*' -print -quit | grep -q . || \
		die 'staged extension is missing the Mutter shared library'
	find "$stage/usr/lib64" -name 'libaccountsservice.so.1*' -type f -print -quit | grep -q . || \
		die 'staged extension is missing the AccountsService shared library'
	find "$stage/usr/lib64" -name 'libgnome-desktop-4.so.2*' -type f -print -quit | grep -q . || \
		die 'staged extension is missing the GNOME desktop shared library'
	find "$stage/usr/lib64" -name 'libx264.so.*' -type f -print -quit | grep -q . || \
		die 'staged extension is missing the x264 shared library'
	for forbidden in \
		usr/libexec/accounts-daemon \
		usr/lib/systemd/system/accounts-daemon.service \
		usr/share/dbus-1/system.d/org.freedesktop.Accounts.conf \
		usr/share/dbus-1/system-services/org.freedesktop.Accounts.service \
		usr/share/polkit-1/actions/org.freedesktop.accounts.policy; do
		[[ ! -e $stage/$forbidden ]] || \
			die "staged extension must not replace the host /$forbidden"
	done
	for manifest_key in \
		BUILD_ID \
		HOST_ID \
		HOST_VERSION_ID \
		HOST_OSTREE_VERSION \
		HOST_KERNEL_RELEASE \
		BUILDER_IMAGE \
		BUILDER_IDENTITY \
		PACKAGING_REVISION \
		PRONK_REVISION \
		CASTKMS_REVISION \
		MUTTER_REVISION \
		CONTROL_CENTER_REVISION \
		WIREPLUMBER_REVISION \
		GVC_REVISION \
		GVDB_REVISION \
		LIBGXDP_REVISION \
		GSETTINGS_DESKTOP_SCHEMAS_REVISION \
		GTK4_REVISION \
		ACCOUNTS_SERVICE_REVISION \
		GNOME_DESKTOP_REVISION; do
		[[ -n $(read_value "$manifest" "$manifest_key") ]] || \
			die "the staged manifest has no $manifest_key"
	done

	unexpected=$(find "$stage" -mindepth 1 -maxdepth 1 ! -name usr ! -name opt -print -quit)
	[[ -z $unexpected ]] || die "sysext stage contains an unsupported top-level path: $unexpected"
	unexpected=$(find "$stage" -xdev \( -type f -o -type d \) -perm /022 -print -quit)
	[[ -z $unexpected ]] || die "sysext stage contains a group/world-writable path: $unexpected"
}

validate_host_abi()
{
	local stage=$1
	local library_path
	local mutter_library
	local x264_plugin
	local target
	local output

	library_path=$(find "$stage/usr/lib64" -type d -print | paste -sd:)
	mutter_library=$(find "$stage/usr/lib64" -name 'libmutter-*.so.*' -type f -print -quit)
	[[ -n $mutter_library ]] || die 'cannot locate the staged Mutter library for ABI validation'
	x264_plugin=$stage/usr/lib64/gstreamer-1.0/libgstx264.so
	[[ -f $x264_plugin ]] || die 'cannot locate the staged GStreamer x264 plugin'

	# Resolve relocations with the running deployment's loader and dependency
	# set. This catches a builder repository that has moved ahead of the exact
	# Silverblue deployment recorded in the extension manifest.
	for target in \
		"$mutter_library" \
		"$x264_plugin" \
		"$stage/usr/bin/gnome-control-center" \
		"$stage/usr/bin/wireplumber" \
		"$stage/usr/bin/pronkd" \
		/usr/bin/gnome-shell; do
		output=$(LD_LIBRARY_PATH="$library_path" ldd -r "$target" 2>&1) || {
			printf '%s\n' "$output" >&2
			die "staged runtime is not link-compatible with the host: $target"
		}
		if grep -Eq 'not found|undefined symbol' <<< "$output"; then
			printf '%s\n' "$output" >&2
			die "staged runtime has unresolved host dependencies: $target"
		fi
	done
}

validate_target_abi()
{
	# This runs in the Fedora image selected by host_version_id().  In
	# particular, a developer can build an extension for a newer guest without
	# accidentally resolving its dependencies against the build machine's
	# older userspace.
	validate_host_abi "$@"
}

label_extension_for_target()
{
	local image=$1
	local policy_type
	local contexts
	local hierarchy

	command -v selinuxenabled >/dev/null 2>&1 || return 0
	selinuxenabled || return 0
	policy_type=$(awk -F= '$1 == "SELINUXTYPE" { print $2; exit }' /etc/selinux/config)
	[[ $policy_type =~ ^[A-Za-z0-9._-]+$ ]] || \
		die "cannot determine the active SELinux policy type: $policy_type"
	contexts="/etc/selinux/$policy_type/contexts/files/file_contexts"
	[[ -r $contexts ]] || die "SELinux file contexts are missing: $contexts"
	command -v setfiles >/dev/null 2>&1 || die 'setfiles is required on an SELinux host'

	# Label the image as an alternate root so files that will appear below
	# /usr and /opt receive their target labels, not /var/lib labels.
	for hierarchy in usr opt; do
		[[ -e $image/$hierarchy ]] || continue
		sudo setfiles -F -r "$image" "$contexts" "$image/$hierarchy"
	done
}

replace_staged_extension()
{
	local temporary=$1
	local staged=$state_dir/staged
	local previous=$state_dir/.staged.previous.$$

	if [[ -e $staged ]]; then
		mv -- "$staged" "$previous"
	fi
	mv -- "$temporary" "$staged"
	if [[ -e $previous ]]; then
		rm -rf --one-file-system -- "$previous"
	fi
}

build_in_container()
{
	local stage=$1
	local identifier=$2
	shift 2

	export PATH=/usr/bin:/usr/sbin:${PATH}
	require_source_bundle

	build_wireplumber "$stage"
	build_gsettings_desktop_schemas "$stage"
	build_gtk4 "$stage"
	build_gnome_desktop "$stage"
	build_accountsservice "$stage"
	build_mutter "$stage"
	build_control_center "$stage"
	trim_gsettings_desktop_schemas_devel "$stage"
	trim_gtk4_devel "$stage"
	trim_gnome_desktop_devel "$stage"
	trim_accountsservice_devel "$stage"
	build_pronk "$stage"
	stage_castkms_runtime_policy "$stage"
	write_extension_metadata "$stage" "$identifier" "$@"
	validate_target_abi "$stage"
}

build_extension()
{
	local identifier
	local packaging_revision
	local pronk_revision
	local castkms_revision
	local mutter_revision
	local control_center_revision
	local wireplumber_revision
	local gvc_revision
	local gvdb_revision
	local libgxdp_revision
	local gsettings_revision
	local gtk_revision
	local accountsservice_revision
	local gnome_desktop_revision

	ensure_state_directories
	require_source_bundle
	builder_exists || die 'the build image is missing; run prepare first'
	require_pinned_castkms_kernel
	# Capture provenance on the host because space-saving submodule object
	# alternates need not be visible inside the isolated build container.
	packaging_revision=$(git_revision "$packaging_root")
	pronk_revision=$(git_revision "$pronk_source")
	castkms_revision=$(git_head_revision "$castkms_source")
	mutter_revision=$(git_revision "$mutter_source")
	control_center_revision=$(git_revision "$control_center_source")
	wireplumber_revision=$(git_revision "$wireplumber_source")
	gvc_revision=$(git_revision "$gvc_source")
	gvdb_revision=$(git_revision "$gvdb_source")
	libgxdp_revision=$(git_revision "$libgxdp_source")
	gsettings_revision=$(git_revision "$gsettings_source")
	gtk_revision=$(git_revision "$gtk_source")
	accountsservice_revision=$(git_revision "$accountsservice_source")
	gnome_desktop_revision=$(git_revision "$gnome_desktop_source")
	identifier=$(build_id "$pronk_revision")
	safe_component "$identifier"
	temporary_stage=$(mktemp -d "$state_dir/.stage.XXXXXX")
	# The stage may be exported as a portable extension image.  mktemp creates
	# it as 0700, which would make a faithfully unpacked image inaccessible to
	# desktop user services even though all staged runtime files are readable.
	chmod 0755 "$temporary_stage"

	log "Building extension $identifier with $(jobs) parallel jobs"
	stage_video_encoder_runtime "$temporary_stage"
	run_in_builder "$script_dir/pronk-dev-sysext" \
		__build-in-container "$temporary_stage" "$identifier" "$run_tests" \
		"$packaging_revision" "$pronk_revision" "$castkms_revision" \
		"$mutter_revision" "$control_center_revision" \
		"$wireplumber_revision" "$gvc_revision" "$gvdb_revision" \
		"$libgxdp_revision" "$gsettings_revision" "$gtk_revision" "$accountsservice_revision" "$gnome_desktop_revision"
	validate_stage "$temporary_stage"
	if running_host_matches_target; then
		validate_host_abi "$temporary_stage"
	else
		log "Target Fedora $(host_version_id) ABI was validated in its builder; skipping the Fedora $(read_value /usr/lib/os-release VERSION_ID) host check"
	fi
	replace_staged_extension "$temporary_stage"
	temporary_stage=
	log "Staged extension is ready in $state_dir/staged"
}

installed_manifest()
{
	printf '%s/pronk/usr/lib/pronk-sysext/manifest\n' "$extension_store"
}

manifest_matches_host()
{
	local manifest=$1
	local expected_ostree
	local expected_kernel

	[[ -r $manifest ]] || return 1
	expected_ostree=$(read_value "$manifest" HOST_OSTREE_VERSION) || return 1
	expected_kernel=$(read_value "$manifest" HOST_KERNEL_RELEASE) || return 1
	[[ $expected_ostree == "$(host_ostree_version)" && $expected_kernel == "$(kernel_release)" ]]
}

install_extension()
{
	local stage=$state_dir/staged
	local manifest=$stage/usr/lib/pronk-sysext/manifest
	local identifier
	local target
	local pending_target
	local pending_link

	[[ -d $stage ]] || die 'no staged extension exists; run build first'
	validate_stage "$stage"
	manifest_matches_host "$manifest" || die 'the staged extension does not match the running deployment and kernel'
	identifier=$(read_value "$manifest" BUILD_ID)
	safe_component "$identifier"
	target=$extension_store/images/$identifier
	pending_target=$extension_store/images/.pending.$identifier.$$
	pending_installed_image=$pending_target
	pending_link=$extension_store/.pronk.$$

	log "Publishing immutable extension image $identifier"
	sudo install -d -m 0755 -o root -g root "$extension_store/images"
	if sudo test -e "$target"; then
		die "an installed image already uses build ID $identifier"
	fi
	sudo install -d -m 0755 -o root -g root "$pending_target"
	sudo cp -a "$stage/." "$pending_target/"
	sudo chown -R root:root "$pending_target"
	sudo chmod -R go-w "$pending_target"
	# mktemp deliberately creates the local staging root as mode 0700. cp -a
	# preserves that root mode on the destination, so normalize the published
	# extension directory itself after copying its contents.
	sudo chmod 0755 "$pending_target"
	label_extension_for_target "$pending_target"
	sudo mv -T "$pending_target" "$target"
	pending_installed_image=
	sudo ln -s "images/$identifier" "$pending_link"
	sudo mv -Tf "$pending_link" "$extension_store/pronk"

	log 'Installing the boot guard and ephemeral overlay policy'
	sudo install -d -m 0755 -o root -g root \
		/etc/pronk-sysext \
		/etc/systemd/system-generators \
		/etc/systemd/sysext.conf.d \
		/etc/systemd/system
	sudo install -m 0644 -o root -g root "$manifest" /etc/pronk-sysext/manifest
	sudo install -m 0755 -o root -g root \
		"$script_dir/sysext/pronk-sysext-generator" \
		/etc/systemd/system-generators/pronk-sysext-generator
	sudo install -m 0644 -o root -g root \
		"$script_dir/sysext/80-pronk-dev.conf" \
		/etc/systemd/sysext.conf.d/80-pronk-dev.conf
	sudo env PRONK_SYSEXT_DISABLED=/dev/null \
		/etc/systemd/system-generators/pronk-sysext-generator

	log 'Installed. Reboot to enter the extension with one consistent desktop stack.'
	log 'A new Fedora deployment or kernel automatically leaves it inactive until rebuilt.'
}

host_is_unlocked()
{
	rpm-ostree status --json | python3 -c '
import json, sys
deployments = json.load(sys.stdin)["deployments"]
raise SystemExit(not any(d.get("booted") and d.get("unlocked") for d in deployments))
'
}

castkms_is_available()
{
	# A modular CastKMS driver has the usual module directory.  The production
	# kernel package builds it in, though, so no /sys/module entry exists even
	# while its faux platform device and DRM node are live.
	[[ -d /sys/module/castkms || -d /sys/devices/faux/castkms/drm ]]
}

activate_extension()
{
	local manifest=/etc/pronk-sysext/manifest

	[[ ! -e /etc/pronk-sysext/disabled ]] || die 'the Pronk extension is disabled'
	manifest_matches_host "$manifest" || die 'the installed extension does not match the running deployment and kernel'
	castkms_is_available || die 'the running kernel does not provide CastKMS'
	if [[ -e /run/ostree-booted ]] && host_is_unlocked; then
		die 'the deployment has a transient /usr overlay; reboot instead of stacking a live sysext on it'
	fi
	log 'Activating the extension without logging out'
	sudo systemctl daemon-reload
	sudo systemd-sysext refresh
	sudo systemctl daemon-reload
	systemctl --user daemon-reload
	systemctl --user start pronk-chromiacast.socket
	systemctl --user restart pipewire.service wireplumber.service
	log 'Runtime services are active. Log out and back in before testing Mutter or Settings.'
}

show_status()
{
	local manifest
	local build
	local expected_ostree
	local expected_kernel

	printf 'Host deployment: %s\n' "$(host_ostree_version 2>/dev/null || printf unknown)"
	printf 'Host kernel:     %s\n' "$(kernel_release)"
	if [[ -L $extension_store/pronk ]]; then
		printf 'Installed image: %s\n' "$(readlink "$extension_store/pronk")"
	else
		printf 'Installed image: none\n'
	fi

	manifest=$(installed_manifest)
	if [[ -r $manifest ]]; then
		build=$(read_value "$manifest" BUILD_ID || printf unknown)
		expected_ostree=$(read_value "$manifest" HOST_OSTREE_VERSION || printf unknown)
		expected_kernel=$(read_value "$manifest" HOST_KERNEL_RELEASE || printf unknown)
		printf 'Build:           %s\n' "$build"
		printf 'Compatibility:   '
		if manifest_matches_host "$manifest"; then
			printf 'matches this boot\n'
		else
			printf 'inactive (needs %s / %s)\n' "$expected_ostree" "$expected_kernel"
		fi
	else
		printf 'Compatibility:   no installed manifest\n'
	fi

	if [[ -e /etc/pronk-sysext/disabled ]]; then
		printf 'Boot guard:      disabled by administrator\n'
	elif [[ -L /run/extensions/pronk ]]; then
		printf 'Boot guard:      exposed at %s\n' "$(readlink /run/extensions/pronk)"
	else
		printf 'Boot guard:      not exposed on this boot\n'
	fi

	printf '\n'
	systemd-sysext status 2>&1 || true
	printf '\nCastKMS: '
	if castkms_is_available; then
		printf 'available in the running kernel\n'
	else
		printf 'not available in the running kernel\n'
	fi
	printf 'Pronk socket: '
	systemctl --user is-active pronk-chromiacast.socket 2>/dev/null || true
}

check_scripts()
{
	local sysext_config=$script_dir/sysext/80-pronk-dev.conf
	local shellcheck_files=(
		"$script_dir/pronk-dev-sysext"
		"$script_dir/sysext/pronk-sysext-generator"
		"$packaging_root/tests/sysext/check-dev-sysext"
	)

	log 'Checking shell syntax'
	bash -n "${shellcheck_files[@]}"
	if command -v podman >/dev/null && [[ -d $podman_root ]] && builder_exists; then
		log 'Running ShellCheck in the persistent builder'
		run_in_builder shellcheck "${shellcheck_files[@]}"
	elif command -v shellcheck >/dev/null; then
		log 'Running ShellCheck'
		shellcheck "${shellcheck_files[@]}"
	fi
	log 'Checking the packaging source bundle'
	require_source_bundle
	log 'Exercising the version guard'
	"$packaging_root/tests/sysext/check-dev-sysext" \
		"$script_dir/sysext/pronk-sysext-generator"
	log 'Checking the system extension mutability policy'
	grep -Fxq '[SysExt]' "$sysext_config"
	grep -Fxq 'Mutable=ephemeral' "$sysext_config"
}

while (($# > 0)); do
	case $1 in
	--run-tests)
		run_tests=true
		shift
		;;
	--rebuild-builder)
		rebuild_builder=true
		shift
		;;
	-h|--help)
		usage
		exit 0
		;;
	-*)
		die "unknown option: $1"
		;;
	*)
		break
		;;
	esac
done

command=${1:-}
[[ -n $command ]] || { usage >&2; exit 2; }
shift

case $command in
prepare)
	(($# == 0)) || die "unexpected argument: $1"
	prepare_builder
	;;
build)
	(($# == 0)) || die "unexpected argument: $1"
	build_extension
	;;
install)
	(($# == 0)) || die "unexpected argument: $1"
	install_extension
	;;
deploy)
	(($# == 0)) || die "unexpected argument: $1"
	prepare_builder
	build_extension
	install_extension
	;;
activate)
	(($# == 0)) || die "unexpected argument: $1"
	activate_extension
	;;
status)
	(($# == 0)) || die "unexpected argument: $1"
	show_status
	;;
check)
	(($# == 0)) || die "unexpected argument: $1"
	check_scripts
	;;
__build-in-container)
	(($# == 16)) || die 'invalid internal build invocation'
	case $3 in
	true|false) run_tests=$3 ;;
	*) die 'invalid internal test setting' ;;
	esac
	build_in_container "$1" "$2" "${@:4}"
	;;
*)
	die "unknown command: $command"
	;;
esac
