ARG FEDORA_VERSION
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

RUN dnf -y install dnf5-plugins && \
    dnf -y builddep mutter gnome-control-center wireplumber && \
    dnf -y install \
        ShellCheck \
        cargo \
        findutils \
        gcc \
        gcc-c++ \
        git \
        gstreamer1-devel \
        gstreamer1-plugins-base-devel \
        libdrm-devel \
        make \
        meson \
        ninja-build \
        pipewire-devel \
        pkgconf-pkg-config \
        rust \
        systemd-devel && \
    dnf clean all

# Keep this small, frequently adjusted tool set in its own layer so adding a
# source-tree build prerequisite does not invalidate the expensive builddep
# layer above.
RUN dnf -y install \
      clang \
      clang-devel \
      clippy \
      dbus-daemon \
      edid-decode \
      gstreamer1-plugins-bad-free \
      jq \
      pipewire-gstreamer \
      pipewire-utils \
      ripgrep \
      rustfmt && \
    dnf clean all
