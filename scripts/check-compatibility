#!/usr/bin/python3
# SPDX-License-Identifier: MIT

import pathlib
import re
import subprocess
import sys
import tomllib
import xml.etree.ElementTree as ET


def fail(message: str) -> None:
    raise SystemExit(f"compatibility error: {message}")


def git_head(path: pathlib.Path) -> str:
    return subprocess.check_output(
        ["git", "-C", path, "rev-parse", "HEAD"], text=True
    ).strip()


def require_patch_base(package: str, repository: pathlib.Path) -> None:
    spec = root / "packages" / package / f"{package}.spec"
    match = re.search(
        r"^%global pronk_base[ \t]+([0-9a-f]{40})$",
        spec.read_text(),
        re.MULTILINE,
    )
    if match is None:
        fail(f"cannot find the patch base in {spec.relative_to(root)}")

    base = match.group(1)
    result = subprocess.run(
        ["git", "-C", repository, "merge-base", "--is-ancestor", base, "HEAD"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode == 1:
        fail(
            f"{repository.relative_to(root)} lacks patch base {base}; "
            "fetch its history before generating the source RPM"
        )
    if result.returncode != 0:
        fail(
            f"cannot verify patch base {base} in "
            f"{repository.relative_to(root)}"
        )


def rust_constant(path: pathlib.Path, name: str) -> int:
    pattern = re.compile(
        rf"^(?:pub\s+)?const {re.escape(name)}: [^=]+ = ([0-9_]+)(?: << ([0-9_]+))?;$",
        re.MULTILINE,
    )
    match = pattern.search(path.read_text())
    if match is None:
        fail(f"cannot find Rust constant {name} in {path}")
    value = int(match.group(1).replace("_", ""))
    if match.group(2) is not None:
        value <<= int(match.group(2).replace("_", ""))
    return value


def c_define(path: pathlib.Path, name: str) -> int:
    pattern = re.compile(
        rf"^#define\s+{re.escape(name)}\s+(?:\(\(guint64\)\s*)?"
        r"\(?(0[xX][0-9a-fA-F]+|[0-9]+)[uUlL]*"
        r"(?:\s*<<\s*([0-9]+)[uUlL]*)?\)?$",
        re.MULTILINE,
    )
    match = pattern.search(path.read_text())
    if match is None:
        fail(f"cannot find C constant {name} in {path}")
    value = int(match.group(1), 0)
    if match.group(2) is not None:
        value <<= int(match.group(2))
    return value


def expect(label: str, actual: int, expected: int) -> None:
    if actual != expected:
        fail(f"{label} is {actual}, expected {expected}")


root = pathlib.Path(__file__).resolve().parent.parent
manifest = tomllib.loads((root / "compatibility.toml").read_text())
if manifest.get("format_version") != 1:
    fail("unsupported manifest format")

components = manifest["components"]
repositories = {
    "pronk_commit": root / "sources/pronk",
    "castkms_commit": root / "sources/castkms",
    "castkms_renderer_commit": root / "sources/castkms-renderer",
    "libdrm_commit": root / "sources/libdrm",
    "mesa_commit": root / "sources/mesa",
    "mutter_commit": root / "sources/mutter",
    "gnome_control_center_commit": root / "sources/gnome-control-center",
    "wireplumber_commit": root / "sources/wireplumber",
    "gsettings_desktop_schemas_commit": root / "sources/gsettings-desktop-schemas",
    "gtk4_commit": root / "sources/gtk",
    "accountsservice_commit": root / "sources/accountsservice",
    "accountsservice_compat_commit": root / "sources/accountsservice-compat",
    "gnome_desktop_commit": root / "sources/gnome-desktop",
    "qrcodegen_commit": root / "sources/qrcodegen",
}
for key, repository in repositories.items():
    actual = git_head(repository)
    expected = components[key]
    if actual != expected:
        fail(f"{repository.relative_to(root)} is at {actual}, expected {expected}")

for package in ("mutter", "gnome-control-center"):
    require_patch_base(package, root / "sources" / package)

libdrm_spec = (root / "packages/libdrm/libdrm.spec").read_text()
libdrm_commit = re.search(
    r"^%global pronk_commit[ \t]+([0-9a-f]{40})$", libdrm_spec, re.MULTILINE
)
if libdrm_commit is None or libdrm_commit.group(1) != components["libdrm_commit"]:
    fail("libdrm RPM source differs from the compatibility manifest")

gsettings_spec = (root / "packages/gsettings-desktop-schemas/gsettings-desktop-schemas.spec").read_text()
gsettings_base = re.search(
    r"^%global pronk_base[ \t]+([0-9a-f]{40})$", gsettings_spec, re.MULTILINE
)
if gsettings_base is None:
    fail("cannot find the GNOME desktop schemas source base")
if gsettings_base.group(1) != components["gsettings_desktop_schemas_commit"]:
    fail("GNOME desktop schemas RPM source base differs from the compatibility manifest")

gtk_spec = (root / "packages/gtk4/gtk4.spec").read_text()
gtk_base = re.search(r"^%global pronk_base[ \t]+([0-9a-f]{40})$", gtk_spec, re.MULTILINE)
if gtk_base is None:
    fail("cannot find the GTK source base")
if gtk_base.group(1) != components["gtk4_commit"]:
    fail("GTK RPM source base differs from the compatibility manifest")

accountsservice_spec = (root / "packages/accountsservice/accountsservice.spec").read_text()
accountsservice_base = re.search(
    r"^%global pronk_base[ \t]+([0-9a-f]{40})$", accountsservice_spec, re.MULTILINE
)
if accountsservice_base is None:
    fail("cannot find the AccountsService source base")
if accountsservice_base.group(1) != components["accountsservice_commit"]:
    fail("AccountsService RPM source base differs from the compatibility manifest")

accountsservice_compat_spec = (root / "packages/accountsservice-compat/accountsservice-compat.spec").read_text()
accountsservice_compat_base = re.search(
    r"^%global pronk_base[ \t]+([0-9a-f]{40})$", accountsservice_compat_spec, re.MULTILINE
)
if accountsservice_compat_base is None:
    fail("cannot find the AccountsService compatibility source base")
if accountsservice_compat_base.group(1) != components["accountsservice_compat_commit"]:
    fail("AccountsService compatibility RPM source base differs from the compatibility manifest")

gnome_desktop_spec = (root / "packages/gnome-desktop3/gnome-desktop3.spec").read_text()
gnome_desktop_base = re.search(
    r"^%global pronk_base[ \t]+([0-9a-f]{40})$", gnome_desktop_spec, re.MULTILINE
)
if gnome_desktop_base is None:
    fail("cannot find the GNOME desktop source base")
if gnome_desktop_base.group(1) != components["gnome_desktop_commit"]:
    fail("GNOME desktop RPM source base differs from the compatibility manifest")

qrcodegen_base = re.search(
    r"^%global qrcodegen_base[ \t]+([0-9a-f]{40})$", gnome_desktop_spec, re.MULTILINE
)
if qrcodegen_base is None:
    fail("cannot find the QR-Code-generator source base")
if qrcodegen_base.group(1) != components["qrcodegen_commit"]:
    fail("QR-Code-generator source base differs from the compatibility manifest")

pronk = root / "sources/pronk"
renderer = root / "sources/castkms-renderer"
cargo = tomllib.loads((pronk / "Cargo.toml").read_text())
chromiacast = cargo["workspace"]["dependencies"]["chromiacast"]
chromiacast_version = chromiacast["version"] if isinstance(chromiacast, dict) else chromiacast
if chromiacast_version != components["chromiacast_version"]:
    fail(
        f"Chromiacast dependency is {chromiacast_version}, "
        f"expected {components['chromiacast_version']}"
    )

interfaces = manifest["interfaces"]
constant_checks = {
    "castkms_monitor_control_version": (
        pronk / "crates/castkms-monitor/src/lib.rs",
        "VERSION",
    ),
    "castkms_monitor_cec_cap": (
        pronk / "crates/castkms-monitor/src/lib.rs",
        "CAP_CEC",
    ),
    "castkms_renderer_version": (
        renderer / "crates/castkms-sys/src/lib.rs",
        "RENDERER_VERSION",
    ),
    "castkms_renderer_constraints_version": (
        renderer / "crates/castkms-sys/src/lib.rs",
        "RENDERER_CONSTRAINTS_VERSION",
    ),
    "castkms_renderer_job_version": (
        renderer / "crates/castkms-sys/src/lib.rs",
        "RENDERER_JOB_VERSION",
    ),
    "backend_protocol_major": (
        pronk / "crates/pronk-backend-protocol/src/lib.rs",
        "PROTOCOL_MAJOR",
    ),
    "backend_protocol_minor": (
        pronk / "crates/pronk-backend-protocol/src/lib.rs",
        "PROTOCOL_MINOR",
    ),
}
for key, (path, constant) in constant_checks.items():
    expect(constant, rust_constant(path, constant), interfaces[key])

castkms_uapi = root / "sources/castkms/include/uapi/drm"
mutter_uapi = root / "sources/mutter/src/backends/native"
libdrm_header = root / "sources/libdrm/xf86drm.h"
cross_component_defines = [
    (
        "generic capture grant capability",
        castkms_uapi / "drm_capture.h",
        mutter_uapi / "meta-drm-capture.h",
        "DRM_CAP_CAPTURE_GRANT",
        "drm_capture_grant_cap",
    ),
    (
        "atomic preparation client capability",
        castkms_uapi / "drm_prepare.h",
        mutter_uapi / "meta-drm-preparation.h",
        "DRM_CLIENT_CAP_ATOMIC_PREPARATION",
        "drm_atomic_preparation_client_cap",
    ),
    (
        "KMS constraints client capability",
        castkms_uapi / "drm_constraints.h",
        mutter_uapi / "meta-drm-constraints.h",
        "DRM_CLIENT_CAP_KMS_CONSTRAINTS",
        "drm_kms_constraints_client_cap",
    ),
    (
        "KMS constraints encoding version",
        castkms_uapi / "drm_constraints.h",
        mutter_uapi / "meta-drm-constraints.h",
        "DRM_MODE_CONSTRAINTS_VERSION",
        "drm_kms_constraints_version",
    ),
    (
        "KMS constraints format-record limit",
        castkms_uapi / "drm_constraints.h",
        mutter_uapi / "meta-drm-constraints.h",
        "DRM_MODE_CONSTRAINTS_MAX_FORMATS",
        "drm_kms_constraints_max_formats",
    ),
    (
        "KMS constraints plane-geometry-record limit",
        castkms_uapi / "drm_constraints.h",
        mutter_uapi / "meta-drm-constraints.h",
        "DRM_MODE_CONSTRAINTS_MAX_PLANE_GEOMETRIES",
        "drm_kms_constraints_max_plane_geometries",
    ),
    (
        "KMS constraints YUV-property applicability flag",
        castkms_uapi / "drm_constraints.h",
        mutter_uapi / "meta-drm-constraints.h",
        "DRM_MODE_CONSTRAINTS_PROPERTY_PLANE_YUV",
        "drm_kms_constraints_property_plane_yuv",
    ),
    (
        "CastKMS monitor-control version",
        castkms_uapi / "castkms_drm.h",
        mutter_uapi / "meta-drm-castkms.h",
        "DRM_CASTKMS_MONITOR_CONTROL_VERSION",
        "castkms_monitor_control_version",
    ),
    (
        "CastKMS monitor CEC capability",
        castkms_uapi / "castkms_drm.h",
        mutter_uapi / "meta-drm-castkms.h",
        "DRM_CASTKMS_MONITOR_CAP_CEC",
        "castkms_monitor_cec_cap",
    ),
]
for label, kernel_path, mutter_path, name, key in cross_component_defines:
    expect(f"kernel {label}", c_define(kernel_path, name), interfaces[key])
    expect(f"Mutter {label}", c_define(mutter_path, name), interfaces[key])

expect(
    "kernel constraints-list closed flag",
    c_define(castkms_uapi / "drm_constraints.h", "DRM_KMS_CONSTRAINTS_LIST_CLOSED"),
    interfaces["drm_kms_constraints_list_closed"],
)
expect(
    "libdrm constraints-list closed flag",
    c_define(libdrm_header, "DRM_KMS_CONSTRAINTS_LIST_CLOSED"),
    interfaces["drm_kms_constraints_list_closed"],
)
if "kms_constraints_list_changed_handler" not in libdrm_header.read_text():
    fail("libdrm does not expose constraints-list notifications")

expect(
    "kernel CastKMS renderer version",
    c_define(castkms_uapi / "castkms_drm.h", "DRM_CASTKMS_RENDERER_VERSION"),
    interfaces["castkms_renderer_version"],
)

for label, name, key in [
    (
        "renderer constraints version",
        "DRM_CASTKMS_RENDERER_CONSTRAINTS_VERSION",
        "castkms_renderer_constraints_version",
    ),
    (
        "renderer job version",
        "DRM_CASTKMS_RENDERER_JOB_VERSION",
        "castkms_renderer_job_version",
    ),
]:
    expect(
        f"kernel {label}",
        c_define(castkms_uapi / "castkms_drm.h", name),
        interfaces[key],
    )

dbus_rust = pronk / "crates/pronk-dbus/src/lib.rs"
expect(
    "Pronk D-Bus API major",
    rust_constant(dbus_rust, "API_MAJOR"),
    interfaces["pronk_dbus_api_major"],
)
expect(
    "Pronk D-Bus API minor",
    rust_constant(dbus_rust, "API_MINOR"),
    interfaces["pronk_dbus_api_minor"],
)
feature_constants = [
    "API_FEATURE_DEVICE_INVENTORY",
    "API_FEATURE_CAST_DISPLAY_LIFECYCLE",
    "API_FEATURE_CAST_DISPLAY_STATE",
    "API_FEATURE_CAST_DISPLAY_DYNAMIC_STATE",
    "API_FEATURE_MEDIA_SESSION_STATE",
]
expect(
    "Pronk D-Bus feature mask",
    sum(rust_constant(dbus_rust, name) for name in feature_constants),
    interfaces["pronk_dbus_required_features"],
)

settings_contract = root / "sources/gnome-control-center/panels/casting"
settings_private = settings_contract / "cc-pronk-variant-private.h"
settings_variant = settings_contract / "cc-pronk-variant.c"
for label, path, name, key in [
    ("Settings D-Bus API major", settings_private, "CC_CASTING_REQUIRED_API_MAJOR", "pronk_dbus_api_major"),
    ("Settings D-Bus API minor", settings_private, "CC_CASTING_REQUIRED_API_MINOR", "pronk_dbus_api_minor"),
    ("Settings D-Bus feature mask", settings_private, "CC_CASTING_REQUIRED_API_FEATURES", "pronk_dbus_required_features"),
    ("Settings public-device limit", settings_private, "CC_CASTING_MAX_PUBLIC_DEVICES", "pronk_max_public_devices"),
    ("Settings public-display limit", settings_private, "CC_CASTING_MAX_PUBLIC_DISPLAYS", "pronk_max_public_displays"),
    ("Settings backend-ID limit", settings_variant, "MAX_BACKEND_ID_BYTES", "pronk_max_backend_id_bytes"),
    ("Settings device-text limit", settings_variant, "MAX_DEVICE_TEXT_BYTES", "pronk_max_device_text_bytes"),
    ("Settings metadata-entry limit", settings_variant, "MAX_METADATA_ENTRIES", "pronk_max_metadata_entries"),
    ("Settings metadata-key limit", settings_variant, "MAX_METADATA_KEY_BYTES", "pronk_max_metadata_key_bytes"),
    ("Settings metadata-value limit", settings_variant, "MAX_METADATA_VALUE_BYTES", "pronk_max_metadata_value_bytes"),
    ("Settings operation-error limit", settings_variant, "MAX_OPERATION_ERROR_BYTES", "pronk_max_operation_error_bytes"),
    ("Settings media-error limit", settings_variant, "MAX_MEDIA_ERROR_BYTES", "pronk_max_media_error_bytes"),
]:
    expect(label, c_define(path, name), interfaces[key])

for key, constant in [
    ("pronk_max_public_devices", "MAX_PUBLIC_DEVICES"),
    ("pronk_max_public_displays", "MAX_PUBLIC_DISPLAYS"),
    ("pronk_max_backend_id_bytes", "MAX_BACKEND_ID_BYTES"),
    ("pronk_max_device_text_bytes", "MAX_DEVICE_TEXT_BYTES"),
    ("pronk_max_metadata_entries", "MAX_METADATA_ENTRIES"),
    ("pronk_max_metadata_key_bytes", "MAX_METADATA_KEY_BYTES"),
    ("pronk_max_metadata_value_bytes", "MAX_METADATA_VALUE_BYTES"),
    ("pronk_max_operation_error_bytes", "MAX_OPERATION_ERROR_BYTES"),
    ("pronk_max_media_error_bytes", "MAX_MEDIA_ERROR_BYTES"),
]:
    expect(f"Pronk {constant}", rust_constant(dbus_rust, constant), interfaces[key])

dbus_xml = (pronk / "data/dbus-1/interfaces/io.github.pronkproject.Pronk1.xml").read_text()
dbus_interface_prefix = f"io.github.pronkproject.Pronk{interfaces['pronk_dbus_api_major']}."
if f'name="{dbus_interface_prefix}' not in dbus_xml:
    fail(f"D-Bus interface prefix {dbus_interface_prefix} is absent")

settings_dbus_xml = (
    root
    / "sources/gnome-control-center/panels/casting/io.github.pronkproject.Pronk1.xml"
).read_text()
if ET.canonicalize(dbus_xml, strip_text=True) != ET.canonicalize(
    settings_dbus_xml, strip_text=True
):
    fail("Pronk and GNOME Settings carry different D-Bus contracts")

mutter_broker = ET.parse(
    root / "sources/mutter/data/dbus-interfaces/org.gnome.Mutter.CastKms.xml"
).getroot()
mutter_interface = mutter_broker.find("interface[@name='org.gnome.Mutter.CastKms']")
if mutter_interface is None:
    fail("Mutter CastKms broker interface is absent")

expected_broker_methods = {
    "CreateDisplaySession": [
        ("in", "u"), ("in", "u"), ("in", "u"), ("in", "u"),
        ("out", "h"), ("out", "h"), ("out", "t"),
    ],
    "ReleaseDisplaySession": [("in", "t")],
}
actual_broker_methods = {method.get("name") for method in mutter_interface.findall("method")}
if actual_broker_methods != set(expected_broker_methods):
    fail(f"Mutter CastKms broker exposes {actual_broker_methods}, expected monitor/capture only")
for name, expected_arguments in expected_broker_methods.items():
    method = mutter_interface.find(f"method[@name='{name}']")
    if method is None:
        fail(f"Mutter CastKms broker method {name} is absent")
    actual_arguments = [
        (argument.get("direction", "in"), argument.get("type"))
        for argument in method.findall("arg")
    ]
    if actual_arguments != expected_arguments:
        fail(
            f"Mutter CastKms broker method {name} has {actual_arguments}, "
            f"expected {expected_arguments}"
        )
    if any(argument_type == "h" for _, argument_type in expected_arguments):
        annotation = method.find("annotation[@name='org.gtk.GDBus.C.UnixFD']")
        if annotation is None or annotation.get("value") != "true":
            fail(f"Mutter CastKms broker method {name} lacks Unix FD support")

requirements = manifest["requirements"]
pronk_rust = cargo["workspace"]["package"]["rust-version"]
if pronk_rust != requirements["rust"]:
    fail(
        f"Pronk Rust floor is {pronk_rust}, "
        f"expected {requirements['rust']}"
    )

kernel_rust = subprocess.check_output(
    [root / "sources/castkms/scripts/min-tool-version.sh", "rustc"], text=True
).strip()
if kernel_rust != requirements["kernel_rust"]:
    fail(
        f"kernel Rust floor is {kernel_rust}, "
        f"expected {requirements['kernel_rust']}"
    )

pipewire_feature = "v" + requirements["pronk_pipewire_api"].replace(".", "_")
pipewire_dependency = cargo["workspace"]["dependencies"]["pipewire"]
if pipewire_feature not in pipewire_dependency["features"]:
    fail(
        f"Pronk does not enable the declared PipeWire API feature {pipewire_feature}"
    )

pronk_spec = (root / "packages/pronk/pronk.spec").read_text()
if f"BuildRequires:  cargo >= {requirements['cargo']}" not in pronk_spec:
    fail("Pronk's RPM Cargo floor differs from the compatibility manifest")
if f"BuildRequires:  rust >= {requirements['rust']}" not in pronk_spec:
    fail("Pronk's RPM Rust floor differs from the compatibility manifest")
if f"%global pipewire_version {requirements['pronk_pipewire_api']}" not in pronk_spec:
    fail("Pronk's RPM PipeWire floor differs from the compatibility manifest")

renderer_cargo = tomllib.loads((renderer / "Cargo.toml").read_text())
renderer_rust = renderer_cargo["workspace"]["package"]["rust-version"]
if renderer_rust != requirements["rust"]:
    fail(f"CastKMS renderer Rust floor is {renderer_rust}, expected {requirements['rust']}")
renderer_spec = (root / "packages/castkms-renderer/castkms-renderer.spec").read_text()
if f"BuildRequires:  rust >= {renderer_rust}" not in renderer_spec:
    fail("CastKMS renderer RPM Rust floor differs from its source")
renderer_unit = (renderer / "systemd/castkms-renderer.service").read_text()
for directive in (
    "ExecStart=/usr/libexec/castkms/castkms-rendererd",
    "CapabilityBoundingSet=CAP_SYS_ADMIN",
    "AmbientCapabilities=CAP_SYS_ADMIN",
    "PrivateNetwork=yes",
    "DevicePolicy=closed",
):
    if not re.search(rf"^{re.escape(directive)}$", renderer_unit, re.MULTILINE):
        fail(f"CastKMS renderer service lacks {directive}")

mutter_spec = (root / "packages/mutter/mutter.spec").read_text()
if f"%global pipewire_version {requirements['tested_pipewire']}" not in mutter_spec:
    fail("Mutter's RPM PipeWire floor differs from the tested stack baseline")

print("compatibility manifest matches all pinned sources")
